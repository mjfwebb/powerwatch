#!/usr/bin/env bash
# powerwatch - live power and electricity-cost monitor for Linux laptops.
#
# Integrates real power sensors over time into cumulative energy (Wh/kWh) and
# cost, and projects a daily/monthly run rate.
#
# Sources, by priority:
#   - Intel RAPL "psys" domain (whole CPU platform: package + iGPU + DRAM + VRMs)
#     read as a monotonic energy counter for exact interval energy. Root-readable
#     only by default; see README.md for the one-line udev rule.
#   - NVIDIA dGPU via `nvidia-smi` (separate power rail, not in RAPL). It runtime-
#     suspends in hybrid/Optimus mode, where it reports no data, counted as ~0 W.
#   - On battery: the battery's power_now is the true whole-machine draw and
#     supersedes the estimate above (it already covers the GPU, screen, everything).
#
# Caveat: on AC, RAPL+GPU is a compute estimate. It leaves out the display
# backlight, AC-adapter conversion loss (~10-15%), USB peripherals and battery
# charging, so it undercounts what your wall meter sees. For bill-accurate cost
# use a smart plug. On battery, power_now is accurate for the laptop itself.
#
# Live pricing (opt-in): set POWERWATCH_LIVE=1 and it fetches the spot price for
# the current slot from a JSON provider, building an all-in price/kWh = (spot +
# markup + grid + tax) * VAT. The provider is pluggable (see PRICE_URL/PRICE_JQ);
# it defaults to elprisetjustnu.se / Nord Pool, which needs a POWERWATCH_ZONE.
# The day's prices are cached under ~/.cache/powerwatch. On any fetch failure, or
# when live pricing is off, it uses the fixed POWERWATCH_RATE.
#
# Usage: powerwatch [interval_seconds]        (default 5)
#   POWERWATCH_LIVE=1     enable live spot pricing          (default 0)
#   POWERWATCH_ZONE=...   bidding zone for the URL template (no default)
#   POWERWATCH_PRICE_URL  price-endpoint template, placeholders {year} {month}
#                         {day} {date} {zone}  (default: elprisetjustnu.se)
#   POWERWATCH_PRICE_JQ   jq program -> spot price/kWh, given --arg t/hour/date/dow
#   POWERWATCH_MARKUP=0   supplier markup, price/kWh ex tax (default 0)
#   POWERWATCH_GRID=0     grid transfer fee, price/kWh ex tax (default 0)
#   POWERWATCH_TAX=0      energy tax, price/kWh ex VAT       (default 0)
#   POWERWATCH_VAT=1      VAT / sales-tax multiplier         (default 1)
#   POWERWATCH_RATE=2.50  fixed price per kWh               (default 2.50)
#   POWERWATCH_CURR=...   currency label                    (default none)
#   POWERWATCH_STICKY=1   pin the header to the top of the terminal; set 0 to
#                         scroll naturally and reprint it each screenful, which
#                         keeps old rows in the terminal's scrollback (default 1)
#                         Press Shift+Tab while running to toggle the two live.

# Force C locale so EPOCHREALTIME / awk use '.' as the decimal separator
# (this box is sv_SE and would otherwise emit '1781242297,100344').
export LC_ALL=C

interval="${1:-5}"
RATE="${POWERWATCH_RATE:-2.50}"
CURR="${POWERWATCH_CURR:-}"
STICKY_PREF="${POWERWATCH_STICKY:-1}"

LIVE="${POWERWATCH_LIVE:-0}"
ZONE="${POWERWATCH_ZONE:-}"
MARKUP="${POWERWATCH_MARKUP:-0}"
GRID="${POWERWATCH_GRID:-0}"
TAX="${POWERWATCH_TAX:-0}"
VAT="${POWERWATCH_VAT:-1}"

# Pluggable price provider (see the usage header above for the env vars).
# The defaults are held in single-quoted vars first: their { } would otherwise
# prematurely close the ${VAR:-default} parameter expansion below.
DEFAULT_PRICE_URL='https://www.elprisetjustnu.se/api/v1/prices/{year}/{month}-{day}_{zone}.json'
# shellcheck disable=SC2016  # $t is a jq variable, not shell
DEFAULT_PRICE_JQ='[ .[] | select(.time_start[11:16] <= $t) ] | last | .SEK_per_kWh // empty'
PRICE_URL="${POWERWATCH_PRICE_URL:-$DEFAULT_PRICE_URL}"
PRICE_JQ="${POWERWATCH_PRICE_JQ:-$DEFAULT_PRICE_JQ}"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/powerwatch"
have_jq=0; command -v jq >/dev/null 2>&1 && have_jq=1
have_curl=0; command -v curl >/dev/null 2>&1 && have_curl=1
# live pricing needs the fetcher + parser, and a zone when the URL template uses one
(( LIVE )) && [[ $PRICE_URL == *'{zone}'* && -z $ZONE ]] && LIVE=0
(( LIVE && (!have_jq || !have_curl) )) && LIVE=0

POWERCAP=/sys/class/powercap

# discover the battery and AC-adapter sysfs nodes by type, since the names vary
# across machines (BAT0/BAT1, AC/ADP1/ACAD, ...). Left empty if absent (desktop).
# Battery draw is read from power_now (µW) where present; some machines (e.g. the
# Steam Deck) omit it but expose current_now/voltage_now, from which P = I·V.
BAT=""; BAT_MODE=""; AC=""
for ps in /sys/class/power_supply/*; do
  [[ -r "$ps/type" ]] || continue
  t=$(<"$ps/type")
  if [[ -z $BAT && $t == Battery ]]; then
    if   [[ -r "$ps/power_now" ]]; then BAT=$ps; BAT_MODE=power
    elif [[ -r "$ps/current_now" && -r "$ps/voltage_now" ]]; then BAT=$ps; BAT_MODE=iv; fi
  fi
  [[ -z $AC  && $t == Mains   && -r "$ps/online"    ]] && AC=$ps
done

# --- discover the best RAPL domain: prefer psys, else package-0 -------------
RAPL_DIR=""; RAPL_NAME=""
for d in "$POWERCAP"/intel-rapl:[0-9]*; do
  [[ -r "$d/name" ]] || continue
  n=$(<"$d/name")
  if [[ $n == psys ]]; then RAPL_DIR=$d; RAPL_NAME=$n; break; fi
  [[ $n == package-0 && -z $RAPL_DIR ]] && { RAPL_DIR=$d; RAPL_NAME=$n; }
done

RAPL_OK=0; RAPL_MAX=0
if [[ -n $RAPL_DIR && -r "$RAPL_DIR/energy_uj" ]] && head -c1 "$RAPL_DIR/energy_uj" >/dev/null 2>&1; then
  RAPL_OK=1
  RAPL_MAX=$(<"$RAPL_DIR/max_energy_range_uj")
fi

# --- AMD APU platform power, used when the RAPL counter is unavailable -------
# On Ryzen APUs (e.g. the Steam Deck) the RAPL energy counter is root-only and,
# unlike Intel's psys, its package domain excludes the iGPU. The amdgpu hwmon
# instead exposes the SoC's package-power tracking (slowPPT: the whole CPU+iGPU
# draw) as an instantaneous µW reading that is readable without root. We take it
# as the AC platform-power source whenever the RAPL counter isn't usable. It is
# an instantaneous power, not a monotonic energy counter, so the main loop
# integrates it over the interval the same way it does the dGPU.
APU_FILE=""
if (( ! RAPL_OK )); then
  for h in /sys/class/hwmon/hwmon*; do
    [[ -r "$h/name" && $(<"$h/name") == amdgpu && -r "$h/power1_input" ]] || continue
    # slowPPT marks the APU package sensor; a discrete Radeon's amdgpu lacks it
    # and its power1 would be GPU-only, so don't mistake that for platform power.
    [[ -r "$h/power1_label" && $(<"$h/power1_label") == slowPPT ]] || continue
    APU_FILE="$h/power1_input"; break
  done
fi

have_nvidia=0; command -v nvidia-smi >/dev/null 2>&1 && have_nvidia=1

# --- colors -----------------------------------------------------------------
if [[ -t 1 ]]; then
  R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'
  GR=$'\e[90m'; BOLD=$'\e[1m'; RST=$'\e[0m'
else
  R='' G='' Y='' C='' GR='' BOLD='' RST=''
fi
pcolor() { local w=$1   # color total watts -> REPLY (no subshell in the hot loop)
  if   (( w < 20 )); then REPLY=$G
  elif (( w < 60 )); then REPLY=$Y
  else                    REPLY=$R; fi
}

# --- terminal dimensions ----------------------------------------------------
# COLS/ROWS are the usable width/height, or 0 when output is not a terminal (no
# width limit, no sticky header). A SIGWINCH trap refreshes them on resize, so
# we only shell out to tput then.
# (A resize landing mid-tick can leave the one line already assembled sized
# for the old width; the next tick uses the new width.)
COLS=0; ROWS=0
esc_re=$'\e''\['"[0-9;]*m"          # one CSI color sequence, for width measurement
get_dims() {
  [[ -t 1 ]] || { COLS=0; ROWS=0; return; }
  # tput can fail (TERM unset/dumb) or report 0; fall back to the shell's
  # COLUMNS/LINES if set, then 80x24. 0 must not leak through for COLS: it would
  # be indistinguishable from "not a terminal" and lift the width limit entirely.
  local c r
  c=$(tput cols  2>/dev/null); [[ $c =~ ^[1-9][0-9]*$ ]] || c=${COLUMNS-}; [[ $c =~ ^[1-9][0-9]*$ ]] && COLS=$c || COLS=80
  r=$(tput lines 2>/dev/null); [[ $r =~ ^[1-9][0-9]*$ ]] || r=${LINES-};   [[ $r =~ ^[1-9][0-9]*$ ]] && ROWS=$r || ROWS=24
}
get_dims
trap get_dims WINCH

# --- readers ----------------------------------------------------------------
rapl_uj() { (( RAPL_OK )) && cat "$RAPL_DIR/energy_uj" 2>/dev/null || echo ""; }

# dGPU watts; empty/N/A (runtime-suspended in hybrid mode) -> 0
gpu_w() {
  (( have_nvidia )) || { echo 0; return; }
  nvidia-smi -q -d POWER 2>/dev/null | awk -F: '
    /Power Draw/ { v=$2; gsub(/[^0-9.]/,"",v); if (v!="") { print v; exit } }
    END { if (!NR) print 0 }' | { read -r v; echo "${v:-0}"; }
}

# AMD APU SoC power in watts (instantaneous), or empty when no APU sensor.
apu_w() { [[ -n $APU_FILE && -r $APU_FILE ]] && awk '{printf "%.3f", $1/1e6}' "$APU_FILE" 2>/dev/null; }

# Battery draw in µW (matching power_now's unit), from whichever source was
# discovered: power_now directly, or current_now (µA) × voltage_now (µV) / 1e6.
bat_uw() {
  if   [[ $BAT_MODE == power ]]; then cat "$BAT/power_now" 2>/dev/null
  elif [[ $BAT_MODE == iv    ]]; then
    awk -v v="$(<"$BAT/voltage_now")" '{printf "%.0f", $1*v/1e6}' "$BAT/current_now" 2>/dev/null
  fi
}

on_battery() { [[ -r "$AC/online" && $(<"$AC/online") == 0 ]]; }

# --- live electricity pricing (pluggable JSON provider) --------------------
# Expand the URL template for a given date (YYYY-MM-DD).
price_url() {
  local d=$1 u=$PRICE_URL
  u=${u//\{year\}/${d:0:4}}; u=${u//\{month\}/${d:5:2}}; u=${u//\{day\}/${d:8:2}}
  u=${u//\{date\}/$d}; u=${u//\{zone\}/$ZONE}
  printf '%s' "$u"
}

# Fetch and cache the day's price document once; echo its cache path on success.
# The cache key is a hash of the resolved URL, so different providers/zones/days
# never collide.
fetch_day() {
  local d=$1 url f
  url=$(price_url "$d")
  f="$CACHE_DIR/$(printf '%s' "$url" | cksum | cut -d' ' -f1).json"
  if [[ ! -s $f ]]; then
    mkdir -p "$CACHE_DIR" 2>/dev/null || return 1
    # shellcheck disable=SC2015  # || is the catch-all failure path, by design
    curl -fsS --max-time 8 "$url" -o "$f.tmp" 2>/dev/null \
      && [[ -s "$f.tmp" ]] && mv -f "$f.tmp" "$f" \
      || { rm -f "$f.tmp"; return 1; }
  fi
  printf '%s' "$f"
}

# Spot price/kWh for the slot covering the current local wall-clock time, or empty.
# The user's jq program gets --arg t (HH:MM), hour (HH), date (YYYY-MM-DD) and
# dow (ISO weekday, 1=Mon .. 7=Sun) for the current local time.
spot_now() {
  local f
  f=$(fetch_day "$(date +%F)") || return 1
  jq -r --arg t "$(date +%H:%M)" --arg hour "$(date +%H)" \
        --arg date "$(date +%F)" --arg dow "$(date +%u)" \
    "$PRICE_JQ" "$f" 2>/dev/null
}

# Effective all-in price for now. Echoes price/kWh; returns 0 if live, 1 if fixed.
eff_rate() {
  local spot
  (( LIVE )) || { printf '%s' "$RATE"; return 1; }
  spot=$(spot_now)
  # fall back to the fixed rate unless the provider gave a real number
  # (a jq filter returning null/empty/garbage must not silently price at 0)
  [[ $spot =~ ^[0-9]+(\.[0-9]+)?$ ]] || { printf '%s' "$RATE"; return 1; }
  awk -v s="$spot" -v m="$MARKUP" -v g="$GRID" -v tx="$TAX" -v v="$VAT" \
    'BEGIN{printf "%.4f", (s+m+g+tx)*v}'
}

# --- sparkline of recent total power, scaled 0..100W ------------------------
# Renders into REPLY at most $1 of the most recent samples (one column each),
# so the caller can size it to whatever width is left on the line.
HIST_MAX=40                          # samples kept, and rendered when unlimited
SPARK=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █); hist=()
sparkline() {
  local max=$1 v idx i start=0
  REPLY=""
  (( max <= 0 )) && return
  (( ${#hist[@]} > max )) && start=$(( ${#hist[@]} - max ))
  for (( i=start; i<${#hist[@]}; i++ )); do
    v=${hist[i]}; (( v < 0 )) && v=0; (( v > 100 )) && v=100
    idx=$(( v*7/100 )); REPLY+="${SPARK[$idx]}"
  done
}

# Visible column-width of a string -> REPLY: strip the color escapes, then drop
# UTF-8 continuation bytes so every multibyte glyph (Σ, a currency label like
# € or öre, ...) counts as one column. Double-width CJK glyphs would still be
# off; none appear here.
vis() {
  local s=$1
  while [[ $s =~ $esc_re ]]; do s=${s//"${BASH_REMATCH[0]}"/}; done
  s=${s//[$'\x80'-$'\xbf']/}
  REPLY=${#s}
}

# When sourced (by the tests), stop here: everything above is definitions and
# read-only discovery, everything below prints and loops.
[[ ${BASH_SOURCE[0]} != "$0" ]] && return 0

STICKY=0

# Keyboard hotkeys need single keypresses, which means non-canonical, no-echo
# input, but only when stdin is a real terminal (not under the tests or a pipe,
# where we must leave the tty alone and just sleep between ticks). Save the
# original termios so cleanup can restore it.
KB=0; STTY_SAVE=""
if [[ -t 0 ]] && STTY_SAVE=$(stty -g 2>/dev/null); then
  stty -icanon -echo 2>/dev/null && KB=1
fi

cleanup() {
  # Restore the terminal mode first, then release the scroll region and drop the
  # cursor below the data before resetting color, so the shell prompt returns
  # under the output, not over the pinned header. (Resetting DECSTBM would
  # otherwise home the cursor.)
  (( KB )) && [[ -n $STTY_SAVE ]] && stty "$STTY_SAVE" 2>/dev/null
  (( STICKY )) && printf '\e[r\e[%d;1H' "$ROWS"
  printf '%s\n' "$RST"
  exit 0
}
trap cleanup INT TERM

# --- header -----------------------------------------------------------------
# Resolve the live price once (a network round-trip). The header is rebuilt on
# every resize, but must not re-fetch each time.
init_rate=""; init_src=1
(( LIVE )) && { init_rate=$(eff_rate); init_src=$?; }

# Build the header into hdr_lines[] (no trailing newlines). Kept in a function
# because the sticky layout reprints it on every SIGWINCH, re-fitting the
# column header to the new width.
hdr_lines=()
build_header() {
  hdr_lines=(); local s keys=""
  # Show the current layout and the live toggle, but only when stdin can
  # actually receive keypresses. The tag is colored per mode (and reads
  # differently) so a Shift+Tab press is unmistakable: cyan PINNED vs yellow
  # SCROLLING. (Reflects POWERWATCH_STICKY, i.e. the mode the toggle selects.)
  if (( KB )); then
    local tag
    if (( STICKY_PREF )); then printf -v tag '%s▔ PINNED%s'    "$C" "$RST"
    else                       printf -v tag '%s↕ SCROLLING%s' "$Y" "$RST"; fi
    printf -v keys '  %s  %sShift+Tab toggles%s' "$tag" "$GR" "$RST"
  fi
  printf -v s '%spowerwatch%s  every %ss  %s(Ctrl+C to quit)%s%s' \
    "$BOLD" "$RST" "$interval" "$GR" "$RST" "$keys"
  hdr_lines+=("$s")
  if (( LIVE )); then
    if (( init_src == 0 )); then
      printf -v s '%sprice: %sLIVE %sspot%s%s → %s%.2f %s/kWh%s %s(markup %s · grid %s · tax %s · VAT ×%s)%s' \
        "$GR" "$BOLD" "${ZONE:+$ZONE }" "$RST" "$GR" "$BOLD" "$init_rate" "$CURR" "$RST" \
        "$GR" "$MARKUP" "$GRID" "$TAX" "$VAT" "$RST"
    else
      printf -v s '%s⚠ %sprice fetch failed, using fixed %s %s/kWh until it recovers%s' \
        "$Y" "${ZONE:+$ZONE }" "$RATE" "$CURR" "$RST"
    fi
    hdr_lines+=("$s")
  else
    printf -v s '%sprice: fixed %s %s/kWh  (set POWERWATCH_LIVE=1 + POWERWATCH_ZONE for live spot)%s' \
      "$GR" "$RATE" "$CURR" "$RST"
    hdr_lines+=("$s")
  fi
  if (( RAPL_OK )); then
    printf -v s '%ssource: RAPL %s + NVIDIA dGPU on AC · battery power_now when unplugged%s' "$GR" "$RAPL_NAME" "$RST"
    hdr_lines+=("$s")
  elif [[ -n $APU_FILE ]]; then
    printf -v s '%ssource: AMD APU SoC power (amdgpu slowPPT) on AC · battery draw when unplugged%s' "$GR" "$RST"
    hdr_lines+=("$s")
  else
    printf -v s '%s⚠ RAPL not readable; run the udev rule (see README) for CPU power.%s' "$Y" "$RST"
    hdr_lines+=("$s")
    printf -v s '%s  Falling back to GPU-only on AC (big undercount); accurate on battery.%s' "$GR" "$RST"
    hdr_lines+=("$s")
  fi
  # Column headers, sized like the data row: the "run rate" label is included
  # only when that column will fit. The sparkline stays unlabeled: its start
  # position varies with the leftover width, so a fixed label can't align.
  local hdr rr
  printf -v hdr '%-8s  %-9s  %-22s  %-15s' \
    "time" "power" "(cpu+gpu / source)" "session"
  rr='  run rate'
  (( COLS == 0 || ${#hdr} + ${#rr} <= COLS )) && hdr+=$rr
  printf -v s '%s%s%s' "$GR" "$hdr" "$RST"
  hdr_lines+=("$s")
}

# Paint the header. HDR_ROWS records its height for the loop's reprint cadence.
# When POWERWATCH_STICKY is on and we're on a terminal with rows to spare, pin
# it: clear the screen, print the header at the top, then confine scrolling to
# the rows below it with a DECSTBM scroll region, so the data scrolls under a
# fixed header (but rows that scroll past are lost to the terminal's scrollback).
# Otherwise (sticky off, piped output, or a terminal too short) print it inline
# and let everything scroll naturally; in the terminal case the main loop then
# reprints it each screenful so it stays visible while old rows stay in scrollback.
HDR_ROWS=0
render_header() {
  build_header
  HDR_ROWS=${#hdr_lines[@]}
  if (( ! STICKY_PREF )) || (( COLS == 0 )) || (( ROWS <= HDR_ROWS + 1 )); then
    STICKY=0
    printf '%s\n' "${hdr_lines[@]}"
    return
  fi
  STICKY=1
  printf '\e[H\e[2J'                            # home + clear screen
  printf '%s\n' "${hdr_lines[@]}"               # header occupies rows 1..HDR_ROWS
  printf '\e[%d;%dr' "$((HDR_ROWS+1))" "$ROWS"  # scroll region: below header .. bottom
  printf '\e[%d;1H' "$((HDR_ROWS+1))"           # park the cursor at its top
}

# Once the header exists, a resize must refresh the dimensions; the pinned mode
# also has to repaint to re-fit the column header and re-establish the scroll
# region. The reprint mode just adopts the new size on its next screenful.
winch_handler() { get_dims; (( STICKY )) && render_header; }
render_header
trap winch_handler WINCH

# Flip the sticky/scrollback layout live (the Shift+Tab hotkey). When leaving the
# pinned mode, release the scroll region first; render_header then repaints in
# whichever mode the new preference selects.
toggle_sticky() {
  (( STICKY_PREF = ! STICKY_PREF ))
  (( STICKY )) && printf '\e[r'      # drop the old scroll region before repaint
  rows_since_hdr=0
  render_header
}

# Idle until the next tick. On a keyboard terminal, poll stdin instead of
# sleeping so a keypress is handled promptly: Shift+Tab (ESC [ Z) toggles the
# layout. A bare read timeout means the interval elapsed, time for the next
# tick. Energy integration uses the real elapsed dt, so key-driven wakeups don't
# distort the totals.
idle() {
  (( KB )) || { sleep "$interval"; return; }
  local deadline to key rest
  deadline=$(awk -v n="$EPOCHREALTIME" -v i="$interval" 'BEGIN{printf "%.3f", n+i}')
  while :; do
    to=$(awk -v d="$deadline" -v n="$EPOCHREALTIME" \
         'BEGIN{r=d-n; if(r<=0) print "x"; else printf "%.3f", r}')
    [[ $to == x ]] && break                       # reached the deadline -> tick
    IFS= read -rsN1 -t "$to" key || break         # timeout/EOF -> tick now
    if [[ $key == $'\e' ]]; then                  # CSI? Shift+Tab is ESC [ Z
      IFS= read -rsN2 -t 0.05 rest
      [[ $rest == '[Z' ]] && toggle_sticky
    fi
  done
}

# --- main loop --------------------------------------------------------------
prev_uj=""; prev_t=""; total_j=0; total_cost=0; start_t="$EPOCHREALTIME"
cur_rate="$RATE"; rate_src=1; rate_min=""; rows_since_hdr=0

while :; do
  now="$EPOCHREALTIME"
  cur_uj=$(rapl_uj)
  g=$(gpu_w)

  if [[ -z $prev_t ]]; then
    prev_uj=$cur_uj; prev_t=$now; idle; continue
  fi

  # Refresh the live price only when the wall-clock minute changes. Prices are
  # per-slot (>=15 min, or hourly/event-based for tariffs), never sub-minute, so
  # this runs jq ~once a minute instead of every tick while still picking up slot
  # boundaries within one interval. When not live, cur_rate stays POWERWATCH_RATE.
  if (( LIVE )); then
    printf -v curmin '%(%H:%M)T' -1
    if [[ $curmin != "$rate_min" ]]; then
      cur_rate=$(eff_rate); rate_src=$?; rate_min=$curmin
    fi
  fi

  # Battery discharge IS the true whole-machine power, so on battery we use it
  # directly and ignore RAPL/GPU; on AC the total is CPU platform (RAPL) + dGPU.
  on_bat=0; pw=0; apu=-1
  if on_battery; then on_bat=1; src=BAT; pw=$(bat_uw); pw=${pw:-0}
  else src=AC; (( RAPL_OK )) || { apu=$(apu_w); apu=${apu:--1}; }
  fi

  # One awk pass for the whole tick: interval power/energy (with RAPL counter
  # wrap correction), running totals, and the projected daily/monthly run rate.
  read -r total_j total_cost tot cw sess_wh day_kwh month_cost totint <<<"$(awk \
    -v ob="$on_bat" -v pt="$prev_t" -v nt="$now" -v pj="$prev_uj" -v cj="$cur_uj" \
    -v rok="$RAPL_OK" -v rmax="$RAPL_MAX" -v g="$g" -v pw="$pw" -v apu="$apu" \
    -v tj="$total_j" -v tc="$total_cost" -v st="$start_t" -v rate="$cur_rate" 'BEGIN{
      dt = nt - pt; if (dt <= 0) dt = 0.001
      if (ob) { cw = 0; tot = pw / 1e6; add_j = tot * dt }
      else {
        # CPU-platform watts and their interval energy: from the RAPL counter
        # delta if usable, else the AMD APU instantaneous power, else nothing.
        if (rok && cj != "" && pj != "") { d = cj - pj; if (d < 0) d += rmax; cw = (d/1e6)/dt; cpuj = d/1e6 }
        else if (apu >= 0)               { cw = apu; cpuj = cw*dt }
        else                             { cw = 0;   cpuj = 0 }
        tot = cw + g; add_j = cpuj + g*dt
      }
      ntj = tj + add_j
      el = nt - st; if (el <= 0) el = 1
      ntc = tc + (add_j/3.6e6)*rate
      wh = ntj/3600; daykwh = (ntj/el)*24/1000; monthcost = daykwh*30*rate
      printf "%.6f %.6f %.2f %.2f %.3f %.3f %.2f %d", ntj, ntc, tot, cw, wh, daykwh, monthcost, int(tot+0.5)
    }')"
  cost=$total_cost

  printf -v ts '%(%H:%M:%S)T' -1
  hist+=("$totint"); (( ${#hist[@]} > HIST_MAX )) && hist=("${hist[@]: -HIST_MAX}")

  if [[ $src == BAT ]]; then detail="batt draw (real)"
  else printf -v detail '%4.1f + %4.1f' "$cw" "$g"; fi

  (( rate_src == 0 )) && rtag=L || rtag=F
  # Assemble the line so it fits the terminal: always show the core columns
  # (time .. rate); add the run-rate projection only when it fits; fill any
  # leftover width with the sparkline. Priority: core > projection > sparkline.
  # (A terminal narrower than the core itself, ~70 cols, still wraps.)
  pcolor "$totint"
  printf -v core '%s%-8s%s  %s%6.1f W%s  %-22s  %sΣ %5.2f Wh  %5.2f %s%s  %s@%.2f%s%s' \
    "$GR" "$ts" "$RST" \
    "$REPLY" "$tot" "$RST" \
    "$detail [$src]" \
    "$GR" "$sess_wh" "$cost" "$CURR" "$RST" \
    "$C" "$cur_rate" "$rtag" "$RST"
  printf -v proj '  ~%4.2f kWh/d  ~%5.0f %s/mo' "$day_kwh" "$month_cost" "$CURR"
  sep='  '                                       # gap before the sparkline

  line=$core
  if (( COLS == 0 )); then                       # not a terminal: no width limit
    sparkline "$HIST_MAX"; line+=$proj$sep$REPLY
  else
    vis "$core"; core_cols=$REPLY
    vis "$proj"; proj_cols=$REPLY
    if (( core_cols + proj_cols <= COLS )); then
      line+=$proj
      spark_cols=$(( COLS - core_cols - proj_cols - ${#sep} ))
      if (( spark_cols > 0 )); then sparkline "$spark_cols"; line+=$sep$REPLY; fi
    fi                                           # else: too narrow, core only
  fi
  printf '%s%s\n' "$line" "$RST"

  # Scrollback-friendly mode (not pinned, but a terminal): once a screenful of
  # rows has gone by, reprint the header inline so it stays in view while the
  # rows it scrolled past remain in the terminal's scrollback.
  if (( ! STICKY && COLS > 0 )); then
    screenful=$(( ROWS - HDR_ROWS )); (( screenful < 1 )) && screenful=1
    if (( ++rows_since_hdr >= screenful )); then render_header; rows_since_hdr=0; fi
  fi

  prev_uj=$cur_uj; prev_t=$now
  idle
done
